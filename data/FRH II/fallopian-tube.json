    "questions": [
        {
            "id": "FT-001",
            "question": "There are normally how many fallopian tubes?",
            "options": {
                "A": "One",
                "B": "Two",
                "C": "Three",
                "D": "Four"
            },
            "answer": "B"
             
        },
        {
            "id": "FT-002",
            "question": "The fallopian tubes extend from the",
            "options": {
                "A": "Cervix",
                "B": "Cornua of the uterus",
                "C": "Ovary directly",
                "D": "Vagina"
            },
            "answer": "B"
             
        },
        {
            "id": "FT-003",
            "question": "Each fallopian tube is approximately",
            "options": {
                "A": "2 cm long",
                "B": "5 cm long",
                "C": "10.1–11.4 cm long",
                "D": "20 cm long"
            },
            "answer": "C"
             
        },
        {
            "id": "FT-004",
            "question": "The fallopian tube is enclosed in the",
            "options": {
                "A": "Lower border of broad ligament",
                "B": "Upper fold of broad ligament",
                "C": "Round ligament",
                "D": "Ovarian ligament"
            },
            "answer": "B"
             
        },
        {
            "id": "FT-005",
            "question": "The fallopian tube has how many major gross parts?",
            "options": {
                "A": "Two",
                "B": "Three",
                "C": "Four",
                "D": "Five"
            },
            "answer": "C"
             
        },
        {
            "id": "FT-006",
            "question": "The narrowest part of the fallopian tube is the",
            "options": {
                "A": "Ampulla",
                "B": "Infundibulum",
                "C": "Interstitial part",
                "D": "Fimbria"
            },
            "answer": "C"
             
        },
        {
            "id": "FT-007",
            "question": "The interstitial part passes through the",
            "options": {
                "A": "Vagina",
                "B": "Uterine wall",
                "C": "Ovary",
                "D": "Broad ligament"
            },
            "answer": "B"
             
        },
        {
            "id": "FT-008",
            "question": "The lumen of the interstitial part is approximately",
            "options": {
                "A": "1 mm",
                "B": "5 mm",
                "C": "1 cm",
                "D": "2 cm"
            },
            "answer": "A"
             
        },
        {
            "id": "FT-009",
            "question": "The isthmus of the fallopian tube is approximately",
            "options": {
                "A": "0.5 cm",
                "B": "2.3 cm",
                "C": "5 cm",
                "D": "7 cm"
            },
            "answer": "B"
             
        },
        {
            "id": "FT-010",
            "question": "Fertilization most commonly occurs in the",
            "options": {
                "A": "Interstitial part",
                "B": "Isthmus",
                "C": "Ampulla",
                "D": "Infundibulum"
            },
            "answer": "C"
             
        },
        {
            "id": "FT-011",
            "question": "The ampulla is the",
            "options": {
                "A": "Narrowest part",
                "B": "Widest part",
                "C": "Shortest part",
                "D": "Most muscular part"
            },
            "answer": "B"
             
        },
        {
            "id": "FT-012",
            "question": "The infundibulum is described as",
            "options": {
                "A": "Cylindrical",
                "B": "Funnel-shaped",
                "C": "Spherical",
                "D": "Triangular"
            },
            "answer": "B"
             
        },
        {
            "id": "FT-013",
            "question": "The terminal margins of the infundibulum are called",
            "options": {
                "A": "Plicae",
                "B": "Fimbriae",
                "C": "Rugae",
                "D": "Septae"
            },
            "answer": "B"
             
        },
        {
            "id": "FT-014",
            "question": "The fimbria that is in contact with the ovary is the",
            "options": {
                "A": "Fimbria uterina",
                "B": "Fimbria ovarica",
                "C": "Fimbria cervicalis",
                "D": "Fimbria vaginalis"
            },
            "answer": "B"
             
        },
        {
            "id": "FT-015",
            "question": "The inner lining of the fallopian tube forms numerous folds called",
            "options": {
                "A": "Rugae",
                "B": "Plicae",
                "C": "Septae",
                "D": "Arbor vitae"
            },
            "answer": "B"
             
        },
        {
            "id": "FT-016",
            "question": "Plicae are most prominent in the",
            "options": {
                "A": "Interstitial part",
                "B": "Ampulla",
                "C": "Uterine cavity",
                "D": "Cervix"
            },
            "answer": "B"
             
        },
        {
            "id": "FT-017",
            "question": "Ciliated cells in the fallopian tube help to",
            "options": {
                "A": "Produce progesterone",
                "B": "Propel the ovum toward the uterus",
                "C": "Produce menstrual blood",
                "D": "Cause cervical dilation"
            },
            "answer": "B"
             
        },
        {
            "id": "FT-018",
            "question": "Non-ciliated cells of the tube are described as",
            "options": {
                "A": "Goblet cells",
                "B": "Squamous cells",
                "C": "Myoepithelial cells",
                "D": "Germinal cells"
            },
            "answer": "A"
             
        },
        {
            "id": "FT-019",
            "question": "The muscular layer of the fallopian tube contains",
            "options": {
                "A": "Only longitudinal muscle",
                "B": "Circular and longitudinal smooth muscle",
                "C": "Skeletal muscle only",
                "D": "Cardiac muscle"
            },
            "answer": "B"
             
        },
        {
            "id": "FT-020",
            "question": "The muscular layer contributes to",
            "options": {
                "A": "Peristaltic movement",
