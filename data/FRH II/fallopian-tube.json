            "answer": "A"
             
        },
        {
            "id": "FT-025",
            "question": "More than 90% of ectopic pregnancies according to the notes are",
            "options": {
                "A": "Cervical",
                "B": "Ovarian",
                "C": "Tubal",
                "D": "Abdominal"
            },
            "answer": "C"
             
        },
        {
            "id": "FT-026",
            "question": "A common cause of tubal pregnancy is previous",
            "options": {
                "A": "Breast infection",
                "B": "Tubal scar or adhesion",
                "C": "Menopause",
                "D": "Lactation"
            },
            "answer": "B"
             
        },
        {
            "id": "FT-027",
            "question": "Chronic pelvic infection that may predispose to tubal pregnancy is",
            "options": {
